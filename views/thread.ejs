<%- include('partials/header') %>
<nav class="crumbs"><a href="/">Forum</a><span>›</span><a href="/kategori/<%= t.cat_slug %>"><%= t.cat_name %></a><span>›</span><span class="crumb-cur"><%= t.title %></span></nav>

<div class="thread-h card">
  <div>
    <h1>
      <% if (t.pinned) { %><span class="tag tag-pin">Sabit</span><% } %>
      <% if (t.locked) { %><span class="tag tag-lock">Kilitli</span><% } %>
      <%= t.title %>
    </h1>
    <p class="muted"><%= h.num(t.reply_count) %> cevap · <%= h.num(t.views) %> görüntülenme · <%= h.dateFull(t.created_at) %></p>
  </div>
  <% if (isMod) { %>
  <div class="mod-actions">
    <form method="post" action="/konu/<%= t.id %>/sabitle"><button class="btn ghost sm"><%= t.pinned ? 'Sabitlemeyi kaldır' : 'Sabitle' %></button></form>
    <form method="post" action="/konu/<%= t.id %>/kilitle"><button class="btn ghost sm"><%= t.locked ? 'Kilidi aç' : 'Kilitle' %></button></form>
    <form method="post" action="/konu/<%= t.id %>/sil" data-confirm="Bu konu ve tüm mesajları silinecek. Emin misin?"><button class="btn danger sm">Konuyu sil</button></form>
  </div>
  <% } %>
</div>

<%- include('partials/pager') %>

<div class="posts">
<% posts.forEach(function (p, i) {
     var mine = user && user.id === p.user_id;
     var online = isOnline(p.user_seen);
     var lv = h.level(p.post_count);
     var isOwner = p.user_id === t.user_id;
     var postUrl = siteUrl + '/mesaj/' + p.id;
     var shareText = t.title + ' - ytconsole';
     var RING = 295.3; %>
  <article class="post card" id="m<%= p.id %>">
    <header class="post-bar">
      <span class="pb-date" title="<%= h.timeAgo(p.created_at) %>"><%= h.dateTime(p.created_at) %></span>
      <% if (p.edited_at) { %><span class="pb-edited" title="<%= h.dateFull(p.edited_at) %>">· düzenlendi</span><% } %>
      <a class="pb-no" href="/mesaj/<%= p.id %>" title="Mesaj bağlantısı">#<%= offset + i + 1 %></a>
    </header>

    <div class="post-user">
      <div class="pu-main">
        <a class="pu-av" href="<%= h.userUrl(p.username) %>" title="Seviye <%= lv.level %>">
          <svg class="pu-ring" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="47" class="ring-bg"/>
            <circle cx="50" cy="50" r="47" class="ring-fg" stroke-dasharray="<%= RING %>" stroke-dashoffset="<%= (RING * (1 - lv.pct)).toFixed(1) %>"/>
          </svg>
          <%- h.avatar(p.username, 'lg') %>
        </a>
        <span class="pu-status<%= online ? ' on' : '' %>" title="<%= online ? 'Çevrimiçi' : 'Çevrimdışı' %>"></span>
        <div class="pu-id">
          <div class="pu-name-row">
            <a class="pu-name role-<%= p.role %>" href="<%= h.userUrl(p.username) %>"><%= p.username %></a>
            <span class="pu-badges">
              <% h.badges(p, isOwner).forEach(function (b) { %>
                <% if (b.cls === 'b-level') { %>
                  <span class="ubadge b-level" title="<%= b.title %>" style="--p:<%= Math.round(b.pct * 100) %>"><%= b.html %></span>
                <% } else { %>
                  <span class="ubadge <%= b.cls %>" title="<%= b.title %>"><%- b.html %></span>
                <% } %>
              <% }) %>
            </span>
          </div>
          <div class="pu-sub"><%= p.role === 'uye' ? h.rank(p.post_count) : h.roleLabel(p.role) %><% if (isOwner) { %> · <span class="owner-txt">Konu sahibi</span><% } %></div>
        </div>
      </div>

      <div class="pu-panel" data-panel>
        <div class="pp-head">
          <span>Rütbe</span><b><%= h.rank(p.post_count) %></b>
        </div>
        <dl class="pp-page" data-page="1">
          <div><dt>ytconsole Yaşı</dt><dd><%= h.forumAge(p.joined) %></dd></div>
          <div><dt>Mesaj</dt><dd><b><%= h.num(p.post_count) %></b></dd></div>
          <div><dt>Beğeni</dt><dd><span class="pp-like">👍</span> <%= h.num(p.likes_received) %></dd></div>
        </dl>
        <dl class="pp-page" data-page="2" hidden>
          <div><dt>Konu</dt><dd><b><%= h.num(p.thread_count) %></b></dd></div>
          <div><dt>Seviye</dt><dd><%= lv.level %> <span class="muted">(%<%= Math.round(lv.pct * 100) %>)</span></dd></div>
          <div><dt>Kanal</dt><dd><% if (p.channel) { %><a href="<%= p.channel %>" target="_blank" rel="nofollow noopener noreferrer">▶ YouTube</a><% } else { %><span class="muted">-</span><% } %></dd></div>
        </dl>
        <div class="pp-nav">
          <button type="button" data-pp="-1" aria-label="Önceki">‹</button>
          <span data-pp-label>1/2</span>
          <button type="button" data-pp="1" aria-label="Sonraki">›</button>
        </div>
      </div>
    </div>

    <div class="post-body"><%- h.formatBody(p.body) %></div>

    <div class="like-bar">
      <button type="button" class="like-btn<%= p.liked ? ' on' : '' %>" data-like="<%= p.id %>" <%= mine ? 'disabled title="Kendi mesajını beğenemezsin"' : '' %>>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 10v10H4V10zm2 10h8l2.5-8.5A1.5 1.5 0 0 0 18 9.5h-5V5.5A1.5 1.5 0 0 0 11.5 4L9 10z" fill="currentColor"/></svg>
        <span data-like-label><%= p.liked ? 'Beğendin' : 'Beğen' %></span>
      </button>
      <div class="likers" data-likers><%= h.likersText(p.likers, p.like_count) %></div>
      <div class="share">
        <a class="sh-fb" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(postUrl) %>" target="_blank" rel="noopener noreferrer" title="Facebook'ta paylaş" aria-label="Facebook'ta paylaş">
          <svg viewBox="0 0 24 24" width="16" height="16"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.6V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.3H7.6V13h2.7v8z" fill="currentColor"/></svg></a>
        <a class="sh-x" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(postUrl) %>&text=<%= encodeURIComponent(shareText) %>" target="_blank" rel="noopener noreferrer" title="X'te paylaş" aria-label="X'te paylaş">
          <svg viewBox="0 0 24 24" width="15" height="15"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.3-8.3L2 3h6.4l4.4 5.8zm-1.1 16.2h1.7L7.4 4.7H5.6z" fill="currentColor"/></svg></a>
        <a class="sh-wa" href="https://wa.me/?text=<%= encodeURIComponent(shareText + ' ' + postUrl) %>" target="_blank" rel="noopener noreferrer" title="WhatsApp'ta paylaş" aria-label="WhatsApp'ta paylaş">
          <svg viewBox="0 0 24 24" width="17" height="17"><path d="M12 2.5a9.4 9.4 0 0 0-8.1 14.2L2.5 21.5l4.9-1.3A9.4 9.4 0 1 0 12 2.5zm0 17.2a7.8 7.8 0 0 1-4-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A7.8 7.8 0 1 1 12 19.7zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8.9-.3.2-.5.1a6.4 6.4 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.2.1-.1 0-.3 0-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6a2.5 2.5 0 0 0 1.7-1.2 2 2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3z" fill="currentColor"/></svg></a>
      </div>
    </div>

    <footer class="post-foot">
      <div class="pf-left">
        <% if (mine || isMod) { %>
          <a class="pf-link" href="/mesaj/<%= p.id %>/duzenle">Düzenle</a>
          <form method="post" action="/mesaj/<%= p.id %>/sil" data-confirm="<%= p.id === firstPostId ? 'Bu ilk mesaj; silinirse konunun tamamı silinir. Emin misin?' : 'Bu mesaj silinecek. Emin misin?' %>">
            <button class="pf-link danger-txt">Sil</button>
          </form>
        <% } %>
      </div>
      <% if (user && (!t.locked || isMod)) { %>
      <div class="pf-right">
        <button type="button" class="pf-btn" data-quote="<%= p.username %>" data-quote-text="<%= h.excerpt(p.body, 300) %>">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M4 5h16v10H9l-4 4v-4H4z" fill="currentColor"/></svg> alıntı
        </button>
        <button type="button" class="pf-btn primary" data-quick-reply>
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M4 5h16v10H9l-4 4v-4H4z" fill="currentColor"/></svg> hızlı cevap
        </button>
      </div>
      <% } %>
    </footer>
  </article>
<% }) %>
</div>

<%- include('partials/pager') %>

<section class="card reply" id="cevap">
  <% if (!user) { %>
    <p class="reply-guest">Cevap yazmak için <a href="/giris?r=<%= encodeURIComponent(base) %>">giriş yap</a> ya da <a href="/kayit">ücretsiz kayıt ol</a>.</p>
  <% } else if (t.locked && !isMod) { %>
    <p class="reply-guest">🔒 Bu konu kilitli, yeni cevap yazılamaz.</p>
  <% } else { %>
    <form method="post" action="/konu/<%= t.id %>/cevap">
      <div class="reply-h"><%- h.avatar(user.username, 'sm') %><b>Cevap yaz</b></div>
      <textarea id="reply-body" name="mesaj" rows="6" maxlength="10000" required placeholder="Düşünceni yaz… (Alıntı için satır başına > koy, YouTube linkleri otomatik gömülür)"></textarea>
      <div class="reply-foot"><span class="muted small">Saygılı ve yapıcı ol 🙂</span><button class="btn" type="submit">Gönder</button></div>
    </form>
  <% } %>
</section>
<%- include('partials/footer') %>
