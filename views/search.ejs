<%- include('partials/header') %>
<nav class="crumbs"><a href="/">Forum</a><span>›</span><span>Arama</span></nav>
<div class="page-h card">
  <form class="search big" action="/ara">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <input name="q" value="<%= term %>" placeholder="Ne arıyorsun?" autofocus>
  </form>
</div>
<% if (term.length < 2) { %>
  <p class="muted pad">Aramak için en az 2 karakter yaz.</p>
<% } else { %>
  <% if (users.length) { %>
  <section class="card user-hits">
    <% users.forEach(function (x) { %><a class="chip" href="<%= h.userUrl(x.username) %>"><%- h.avatar(x.username, 'sm') %><%= x.username %></a><% }) %>
  </section>
  <% } %>
  <section class="card list">
    <div class="list-h"><h2><%= threads.length %> konu bulundu</h2></div>
    <% if (!threads.length) { %><div class="empty"><p>“<%= term %>” için sonuç yok. Farklı kelimeler dene ya da <a href="/yeni-konu">yeni konu aç</a>.</p></div><% } %>
    <% threads.forEach(function (t) { %><%- include('partials/thread-row', { t: t, showCat: true }) %><% }) %>
  </section>
<% } %>
<%- include('partials/footer') %>
