<%- include('partials/header') %>
<section class="card form-card auth">
  <h1>Topluluğa katıl</h1>
  <p class="muted">Kayıt ücretsiz, 10 saniye sürer.</p>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form method="post" action="/kayit" class="form">
    <label>Kullanıcı adı<input name="username" autocomplete="username" required minlength="3" maxlength="20" pattern="[a-zA-Z0-9_.]+" value="<%= form.username || '' %>" autofocus></label>
    <label>Şifre<input name="password" type="password" autocomplete="new-password" required minlength="6"></label>
    <label>Şifre (tekrar)<input name="password2" type="password" autocomplete="new-password" required minlength="6"></label>
    <button class="btn block" type="submit">Kayıt ol</button>
  </form>
  <p class="muted center">Zaten üye misin? <a href="/giris">Giriş yap</a></p>
</section>
<%- include('partials/footer') %>
