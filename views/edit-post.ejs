<%- include('partials/header') %>
<nav class="crumbs"><a href="/">Forum</a><span>›</span><a href="/kategori/<%= t.cat_slug %>"><%= t.cat_name %></a><span>›</span><a href="<%= h.threadUrl(t) %>"><%= t.title %></a></nav>
<section class="card form-card wide">
  <h1>Mesajı düzenle</h1>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form method="post" action="/mesaj/<%= post.id %>/duzenle" class="form">
    <% if (isFirst) { %>
    <label>Başlık
      <input name="baslik" maxlength="120" minlength="5" required value="<%= form.baslik %>">
    </label>
    <% } %>
    <label>Mesaj
      <textarea name="mesaj" rows="12" maxlength="10000" required><%= form.mesaj %></textarea>
    </label>
    <div class="form-foot"><a class="btn ghost" href="/mesaj/<%= post.id %>">Vazgeç</a><button class="btn" type="submit">Kaydet</button></div>
  </form>
</section>
<%- include('partials/footer') %>
