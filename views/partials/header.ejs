<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' · ytconsole' : 'ytconsole · YouTube İçerik Üreticileri Forumu' %></title>
<meta name="description" content="ytconsole: YouTube içerik üreticilerinin bilgi paylaştığı, soru sorduğu ve birlikte büyüdüğü ücretsiz forum.">
<script>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23a8344f'/%3E%3Cpath d='M12 9.5v13l11-6.5z' fill='white'/%3E%3C/svg%3E">
<link rel="stylesheet" href="/static/style.css?v=4">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-in">
    <a class="logo" href="/" aria-label="ytconsole ana sayfa">
      <svg class="mascot" viewBox="0 0 64 64" width="48" height="48" aria-hidden="true">
        <g class="m-ant" stroke="#17171a" stroke-width="3" stroke-linecap="round">
          <path d="M25 20 L17 7" /><path d="M39 20 L47 7" />
          <circle cx="17" cy="7" r="4" fill="#fff"/><circle cx="47" cy="7" r="4" fill="#b4415e"/>
        </g>
        <rect x="6" y="18" width="52" height="42" rx="15" fill="#fff" stroke="#17171a" stroke-width="3"/>
        <ellipse cx="22" cy="32" rx="4.2" ry="5.4" fill="#17171a"/>
        <path d="M37 33 q5 -6 10 0" fill="none" stroke="#17171a" stroke-width="3.2" stroke-linecap="round"/>
        <circle cx="23.4" cy="30.2" r="1.4" fill="#fff"/>
        <path d="M14 40 Q32 62 50 40 Z" fill="#17171a" stroke="#17171a" stroke-width="2.5" stroke-linejoin="round"/>
        <path d="M17 41.5 H47 L45 44.5 H19 Z" fill="#fff"/>
        <path d="M25 51 Q32 46 39 51 Q32 55.5 25 51 Z" fill="#b4415e"/>
      </svg>
      <span class="logo-stack">
        <span class="logo-text">yt<b>console</b></span>
        <span class="slogan">Kanalını <svg viewBox="0 0 24 24" width="13" height="13" aria-label="sevgiyle"><path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.2 3 4.5 6.6 4.5c2.2 0 3.8 1.3 5.4 3.2 1.6-1.9 3.2-3.2 5.4-3.2 3.6 0 5.7 3.7 4.2 7.2C19.5 16.4 12 21 12 21z" fill="#b4415e"/></svg> ile <b>büyüt</b> <span class="yt-tag"><svg viewBox="0 0 24 24" width="9" height="9" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" fill="currentColor"/></svg>YOUTUBE</span></span>
      </span>
    </a>
    <nav class="mainnav">
      <a href="/" class="<%= path === '/' ? 'on' : '' %>">Forum</a>
      <a href="/yeni-mesajlar" class="<%= path === '/yeni-mesajlar' ? 'on' : '' %>">Yeni Mesajlar</a>
      <a href="/uyeler" class="<%= path === '/uyeler' ? 'on' : '' %>">Üyeler</a>
    </nav>
    <form class="search" action="/ara" role="search">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input name="q" placeholder="Konu, mesaj ya da üye ara" value="<%= searchQ %>" aria-label="Forumda ara">
    </form>
    <div class="top-actions">
      <a class="online-pill" href="/cevrimici" title="Şu an forumda olanlar">
        <span class="live-dot"></span><b data-online-total><%= online.total %></b><span class="pill-txt">çevrimiçi</span>
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Temayı değiştir">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      </button>
      <% if (user) { %>
        <details class="usermenu">
          <summary><%- h.avatar(user.username, 'sm') %><span class="um-name"><%= user.username %></span>
            <svg viewBox="0 0 24 24" width="14" height="14"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary>
          <div class="menu">
            <a href="<%= h.userUrl(user.username) %>">Profilim</a>
            <a href="/profil/duzenle">Profili düzenle</a>
            <a href="/yeni-konu">Yeni konu aç</a>
            <form method="post" action="/cikis"><button type="submit">Çıkış yap</button></form>
          </div>
        </details>
      <% } else { %>
        <a class="btn ghost sm" href="/giris">Giriş</a>
        <a class="btn sm" href="/kayit">Kayıt ol</a>
      <% } %>
    </div>
  </div>
</header>
<main class="wrap main">
