<%- include('partials/header') %>
<nav class="crumbs"><a href="/">Forum</a><span>›</span><span><%= cat.name %></span></nav>
<div class="layout">
  <div class="col-main">
    <div class="page-h card">
      <div class="cat-icon lg"><%= cat.icon %></div>
      <div class="ph-text">
        <h1><%= cat.name %></h1>
        <p><%= cat.description %> · <%= h.num(total) %> konu</p>
      </div>
      <% if (cat.slug !== 'duyurular' || isMod) { %>
      <a class="btn" href="/yeni-konu?kategori=<%= cat.slug %>">
        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        Yeni konu
      </a>
      <% } %>
    </div>

    <section class="card list">
      <% if (!threads.length) { %>
        <div class="empty">
          <p>Bu kategoride henüz konu yok.</p>
          <% if (cat.slug !== 'duyurular' || isMod) { %><a class="btn" href="/yeni-konu?kategori=<%= cat.slug %>">İlk konuyu sen aç</a><% } %>
        </div>
      <% } %>
      <% threads.forEach(function (t) { %><%- include('partials/thread-row', { t: t, showCat: false }) %><% }) %>
    </section>
    <%- include('partials/pager') %>
  </div>
  <%- include('partials/sidebar') %>
</div>
<%- include('partials/footer') %>
